// Return a structure with two functions that share a counter.
let makeCounters = fun () -> {
    let mutable i = 0;

    struct {
        f1 = fun () -> {
            i <- i + 1;
            i
        };

        f2 = fun () -> {
            i <- i + 1;
            i
        }
    }
};

let c1 = makeCounters();

assert(c1.f1() = 1);
assert(c1.f2() = 2);

let c2 = makeCounters();

assert(c2.f2() = 1);
assert(c2.f1() = 2)